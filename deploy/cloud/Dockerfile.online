# Build from the private online/ directory in a prepared release.
ARG NODE_VERSION
FROM node:${NODE_VERSION}-bookworm-slim
WORKDIR /srv
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/online/package.json apps/online/package.json
RUN npm install --global pnpm@10.30.1 && pnpm --filter online install --frozen-lockfile
COPY --chown=node:node apps/online ./apps/online
WORKDIR /srv/apps/online
ARG NEXT_BUILD_ID
RUN test -n "$NEXT_BUILD_ID" && test "$(cat .next/BUILD_ID)" = "$NEXT_BUILD_ID"
USER node
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
