KYALULU_CLOUD_MODE=1
KYALULU_CLOUD_DATA_DIR=/data
KYALULU_CLOUD_BACKUP_DIR=/backups
KYALULU_CLOUD_ORIGIN=https://cloud.kyalulu.com
KYALULU_CLOUD_SECRET=
KYALULU_SUPABASE_URL=
KYALULU_SUPABASE_ANON_KEY=
KYALULU_DEEPSEEK_API_KEY=
KYALULU_OPERATOR_BACKEND=openrouter
# Hosted route pins DeepSeek V4.1 Flash to InferenceNet, with no provider fallback.
# Keep approval off until real API, privacy/retention and billed-cost acceptance.
KYALULU_OPENROUTER_API_KEY=
KYALULU_OPENROUTER_APPROVED=0
# New accounts only. Existing accounts may still log in, delete and export.
KYALULU_CLOUD_SIGNUP_LIMIT=10
# Before public launch use .env.private-test.example: one invited email, no sales.
KYALULU_PRIVATE_TEST=0
KYALULU_CLOUD_ALLOWED_EMAILS=
KYALULU_CLOUD_TRIAL_CREDITS=1000
KYALULU_TEST_BUDGET_NANO_USD=0
KYALULU_TEST_PRIOR_COST_NANO_USD=0
KYALULU_INFERENCE_APPROVED=0
KYALULU_IMAGES_APPROVED=0
KYALULU_BILLING_APPROVED=0
KYALULU_LEGAL_APPROVED=0
KYALULU_ADS_APPROVED=0
KYALULU_STRIPE_SECRET_KEY=
KYALULU_STRIPE_WEBHOOK_SECRET=
KYALULU_STRIPE_PRICE_PLUS=
KYALULU_STRIPE_PRICE_PRO=
KYALULU_STRIPE_PRICE_CREDITS_5=
KYALULU_STRIPE_PRICE_CREDITS_10=
KYALULU_MONTHLY_SUBSIDY_JPY=3000
KYALULU_BUDGET_USD_JPY=200
KYALULU_TAX_RESERVE_PERCENT=30
# Set this to an independently provisioned offsite object URL only for the admin
# backup upload command. It must not be printed in logs or committed.
KYALULU_OFFSITE_UPLOAD_URL=
