# My Zeta - 環境変数サンプル (このファイルを .env にコピーして使う)
# コミットしないこと！

# Ollama (デフォルト: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# LM Studio (デフォルト: http://127.0.0.1:1234/v1)
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# 外部 OpenAI互換API (試運転用)
# 例: OpenAI本家なら https://api.openai.com/v1
# 例: 別プロバイダならそのベースURL
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=

# アプリ
APP_HOST=127.0.0.1
APP_PORT=8000
