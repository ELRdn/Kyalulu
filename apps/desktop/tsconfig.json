{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "out",
    "baseUrl": ".",
    "paths": {
      "@web/*": ["../web/src/*"]
    }
  },
  "include": ["src/**/*", "electron.vite.config.ts"]
}
