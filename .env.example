# My Zeta - 環境変数サンプル (このファイルを .env にコピーして使う)
# コミットしないこと！

# Ollama (デフォルト: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# LM Studio (デフォルト: http://127.0.0.1:1234/v1)
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# 外部 OpenAI互換API (試運転用)
# 例: OpenAI本家なら https://api.openai.com/v1
# 例: 別プロバイダならそのベースURL
# 重要: /chat/completions は含めないこと
OPENAI_COMPATIBLE_URL=https://opencode.ai/zen/go/v1
OPENAI_COMPATIBLE_API_KEY=
# ↑ opencode go で muse-spark を使う場合は上記URL + APIキーを設定
#   APIキーは手動で .env に記入（.env.exampleには書かない）

# ローカル llama.cpp / RunPod vLLM - LLM_* は OPENAI_COMPATIBLE_* のエイリアスとしても使える
# /v1/models で返ったIDをそのまま LLM_MODEL に入れる
LLM_BASE_URL=http://127.0.0.1:18000/v1
LLM_API_KEY=sk-local
LLM_MODEL=Zeta_Spotwrite-1_4bit.gguf

# アプリ
APP_HOST=127.0.0.1
APP_PORT=8000
