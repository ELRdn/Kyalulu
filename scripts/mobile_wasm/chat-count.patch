+    res.success.value = false;
+    res.input_tokens.value = 0;
+    try
+    {
+      PARSE_REQ(glue_msg_count_chat_req);
+      if (!ctx || !vocab || !meta) { throw std::runtime_error("Model not loaded"); }
+      // This mobile text endpoint bounds wire and rendered bytes, not context tokens.
+      constexpr size_t max_bytes = 4 * 1024 * 1024;
+      if (req.data_json.value.size() > max_bytes) { throw std::runtime_error("Count payload too large"); }
+      // Bound nesting before common_json allocates its backing tree; parsing still validates syntax.
+      size_t depth = 0;
+      bool quoted = false, escaped = false;
+      for (char ch : req.data_json.value) {
+        if (quoted) {
+          if (escaped) { escaped = false; }
+          else if (ch == '\\') { escaped = true; }
+          else if (ch == '"') { quoted = false; }
+        } else if (ch == '"') { quoted = true; }
+        else if (ch == '{' || ch == '[') {
+          if (++depth > 32) { throw std::runtime_error("Count metadata too deep"); }
+        } else if ((ch == '}' || ch == ']') && depth) { --depth; }
+      }
+      json body = json::parse(req.data_json.value);
+      if (!body.is_object() || !body.contains("messages") || !body.at("messages").is_array()
+          || body.at("messages").empty() || body.contains("files"))
+      { throw std::runtime_error("Expected text chat messages"); }
+      for (const auto & message : body.at("messages"))
+      {
+        if (!message.is_object() || !message.contains("role") || !message.at("role").is_string()
+            || !message.contains("content") || !message.at("content").is_string())
+        { throw std::runtime_error("Expected text chat messages"); }
+        const auto role = message.at("role").get<std::string>();
+        if (role != "system" && role != "user" && role != "assistant")
+        { throw std::runtime_error("Unsupported chat role"); }
+      }
+      std::vector<raw_buffer> files;
+      const auto parsed = oaicompat_chat_params_parse(body, meta->chat_params, files);
+      if (!files.empty() || !parsed.at("prompt").is_string())
+      { throw std::runtime_error("Only text prompts are supported"); }
+      if (parsed.at("prompt").get<std::string>().size() > max_bytes)
+      { throw std::runtime_error("Rendered prompt too large"); }
+      const auto tokens = tokenize_mixed(vocab, parsed.at("prompt"), true, true);
+      if (tokens.size() > static_cast<size_t>(std::numeric_limits<int32_t>::max()))
+      { throw std::runtime_error("Token count overflow"); }
+      res.input_tokens.value = static_cast<int32_t>(tokens.size());
+      res.success.value = true;
+    }
+    catch (const std::exception & e)
+    {
+      res.error.value = e.what();
+    }
+    catch (...)
+    {
+      res.error.value = "Chat token count failed";
+    }
+    return res;
+  }
