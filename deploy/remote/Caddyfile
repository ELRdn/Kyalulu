{
    admin off
    log default {
        output discard
    }
    servers {
        timeouts {
            read_header 5s
            read_body 10s
            idle 30s
        }
        max_header_size 16KB
    }
}

:8080 {
    bind 127.0.0.1
    respond /healthz "ok" 200
}

{$APP_DOMAIN} {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://{$RELAY_DOMAIN} wss://{$RELAY_DOMAIN}; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
    }
    root * /srv/app
    @private path /.env /.git/* /config.json
    respond @private 404
    @entry path / /index.html /sw.js /manifest.webmanifest
    header @entry Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
}

{$RELAY_DOMAIN} {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
    }
    request_body {
        max_size 4KB
    }
    reverse_proxy relay:8787
}
