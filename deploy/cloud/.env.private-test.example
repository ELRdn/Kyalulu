# Copy to a Git-ignored .env.cloud.local or deploy/cloud/.env; never commit secrets.
KYALULU_CLOUD_MODE=1
KYALULU_PRIVATE_TEST=1
KYALULU_CLOUD_ALLOWED_EMAILS=replace-with-your-google-email@example.com
KYALULU_CLOUD_SIGNUP_LIMIT=1
# Grant 500 credits using the offline admin command after first verified login.
KYALULU_CLOUD_TRIAL_CREDITS=0
KYALULU_CLOUD_DATA_DIR=/data
KYALULU_CLOUD_BACKUP_DIR=/backups
KYALULU_CLOUD_ORIGIN=https://cloud.kyalulu.com
KYALULU_CLOUD_SECRET=
KYALULU_SUPABASE_URL=
KYALULU_SUPABASE_ANON_KEY=
KYALULU_OPERATOR_BACKEND=openrouter
KYALULU_OPENROUTER_API_KEY=
# Enable only after Google login and selected production transport acceptance.
KYALULU_OPENROUTER_APPROVED=0
KYALULU_INFERENCE_APPROVED=0
KYALULU_IMAGES_APPROVED=0
KYALULU_BILLING_APPROVED=0
KYALULU_LEGAL_APPROVED=0
KYALULU_ADS_APPROVED=0
KYALULU_MONTHLY_SUBSIDY_JPY=0
# Cumulative $0.10 authorized; earlier actual fees PLUS unknown reservations.
KYALULU_TEST_BUDGET_NANO_USD=100000000
KYALULU_TEST_PRIOR_COST_NANO_USD=49548721
